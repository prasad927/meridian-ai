# ============================================================
# THE TOGGLE:  local 
#   local -> only GOOGLE_API_KEY is needed. Vectors in Chroma (.meridian/chroma),
#            uploaded PDFs in .meridian/uploads.
# ============================================================
APP_MODE=local
ENVIRONMENT=local

GOOGLE_API_KEY=your-gemini-api-key

# Optional (these are the defaults)
VERTEX_LLM_MODEL_NAME=gemini-3.8-flash
LLM_TEMPERATURE=0.0
LOCAL_EMBEDDING_MODEL_NAME=gemini-embedding-001
# LOCAL_DATA_DIR=./.meridian

# Agent middleware guard-rails (optional, these are the defaults)
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_RETRIES=2
